{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-behavior-v2.schema.json",
  "title": "World v2 behavior descriptor",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "contractVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "name": {
      "type": "string"
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/)(?!.*[\\\\:]).+$"
    },
    "targetKind": {
      "enum": [
        "item",
        "anchor"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "onUse",
          "onStepIn",
          "onStepOut",
          "onAddItem",
          "onRemoveItem",
          "onEquip",
          "onDeEquip"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "world-common-v2.schema.json#/$defs/parameter"
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "const": "objectRef"
          },
          "targetKind": {
            "enum": [
              "item",
              "anchor"
            ]
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          },
          "allowOffset": {
            "type": "boolean"
          },
          "minimum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "maximum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "label": {
            "type": "string"
          },
          "help": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "contractVersion",
    "script",
    "targetKind",
    "events"
  ],
  "additionalProperties": false
}
