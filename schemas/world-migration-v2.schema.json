{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-migration-v2.schema.json",
  "title": "World migration ownership record",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "receipt": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to tool-owned recovery metadata; not runtime configuration."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "file",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "declaration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file",
              "table",
              "key",
              "fingerprint"
            ],
            "additionalProperties": false
          },
          "occurrence": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "attributes.aid",
                "attributes.uid",
                "attributes.text",
                "attributes.description",
                "attributes.name",
                "attributes.article",
                "attributes.plural",
                "attributes.writer",
                "attributes.date",
                "attributes.custom",
                "creation",
                "replacement",
                "onUse",
                "onStepIn",
                "onStepOut",
                "onAddItem",
                "onRemoveItem"
              ]
            }
          }
        },
        "required": [
          "source",
          "occurrence",
          "object",
          "responsibilities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sources",
    "claims"
  ],
  "additionalProperties": false
}
