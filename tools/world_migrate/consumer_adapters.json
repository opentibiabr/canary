  "schemaVersion": 1,
  "files": {
    "scripts/actions/system/quest_reward_common.lua": {
      "kind": "gameplay",
      "afterSha256": "4895c92791cc9a3c2612cc5b69e009dd39826c9fc7b06d3e3e6897d728f7db0f",
      "beforeSha256": "3394214ca803640b0148854f3a2cb8dd8e4ecd3749268800d4a3f8c50330f1cd",
      "patches": [
        {
          "startLine": 0,
          "before": [
            "-- Common chest reward",
            "-- You just need to add a new table in the data/startup/tables/chest.lua file",
            "-- This script will pull everything from there"
          ],
          "after": [
            "-- Compatibility configuration for the legacy reward handler.",
            "-- New World rewards are authored in world JSON and use the same execution helper."
          ]
        },
        {
          "startLine": 58,
          "before": [
            "local function playerAddItem(params, item, rewardIndex)",
            "\tlocal player = params.player",
            "\tif not checkWeightAndBackpackRoom(player, params.weight, params.message) then",
            "\t\treturn false",
            "\tend",
            "",
            "\tif params.key then",
            "\t\tlocal itemType = ItemType(params.itemid)",
            "\t\t-- 21392 Is key of Dawnport",
            "\t\t-- Needs independent verification because it cannot be set as \"key\" in items.xml",
            "\t\t-- Because it generate bug in the item description",
            "\t\tif itemType:isKey() or itemType:getId(21392) then",
            "\t\t\t-- If is key not in container, uses the \"isKey = true\" variab",
            "\t\t\tkeyItem = player:addItem(params.itemid, params.count)",
            "\t\t\tkeyItem:setActionId(params.storage)",
            "\t\tend",
            "\telse",
            "\t\taddItem = player:addItem(params.itemid, params.count)",
            "\t\t-- If the item is writeable, just put its unique and the text in the \"AttributeTable\"",
            "\t\tlocal attribute = AttributeTable[item.uid]",
            "\t\tif attribute then",
            "\t\t\taddItem:setAttribute(ITEM_ATTRIBUTE_TEXT, attribute.text)",
            "\t\tend",
            "\t\tlocal achievement = achievementTable[item.uid]",
            "\t\tif achievement then",
            "\t\t\tplayer:addAchievement(achievement)",
            "\t\tend",
            "\tend",
            "",
            "\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, params.message .. \".\")",
            "\tif params.useKV then",
            "\t\tplayer:questKV(params.questName):set(\"completed\", true)",
            "\t\tif params.timer then",
            "\t\t\tplayer:questKV(params.questName):set(\"params.questName\", os.time() + params.time * 3600) -- multiplicação por hora",
            "\t\tend",
            "\telse",
            "\t\tif params.storage == nil then",
            "\t\t\tlogger.warn(\"Storage key is nil for reward index {}, itemid {}\", rewardIndex, params.itemid)",
            "\t\t\treturn false",
            "\t\tend",
            "",
            "\t\tplayer:setStorageValue(params.storage, 1)",
            "\t\tif params.timer then",
            "\t\t\tplayer:setStorageValue(params.timer, os.time() + params.time * 3600) -- multiplicação por hora",
            "\t\tend",
            "\tend",
            "\treturn true",
            "end",
            "",
            "local function playerAddContainerItem(params, item, rewardIndex)",
            "\tlocal player = params.player",
            "",
            "\tlocal reward = params.containerReward",
            "\tlocal itemType = ItemType(params.itemid)",
            "\tif itemType:isKey() then",
            "\t\tkeyItem = reward:addItem(params.itemid, params.count)",
            "\t\tif params.storage then",
            "\t\t\tkeyItem:setActionId(params.action)",
            "\t\tend",
            "\telse",
            "\t\tlocal rewardItem = reward:addItem(params.itemid, params.count)",
            "\t\tlocal attribute = AttributeTable[item.uid]",
            "\t\tif attribute and rewardItem then",
            "\t\t\trewardItem:setAttribute(ITEM_ATTRIBUTE_TEXT, attribute.text)",
            "\t\tend",
            "\tend",
            "",
            "\tlocal achievement = achievementTable[item.uid]",
            "\tif achievement then",
            "\t\tplayer:addAchievement(achievement)",
            "\tend",
            "",
            "\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, \"You have found a \" .. getItemName(params.itemBagName) .. \".\")",
            "\tif params.useKV then",
            "\t\tplayer:questKV(params.questName):set(\"completed\", true)",
            "\t\tif params.timer then",
            "\t\t\tplayer:questKV(params.questName):set(\"params.questName\", os.time() + params.time * 3600) -- multiplicação por hora",
            "\t\tend",
            "\telse",
            "\t\tif params.storage == nil then",
            "\t\t\tlogger.warn(\"Storage key is nil for reward index {}, itemid {} in container\", rewardIndex, params.itemid)",
            "\t\t\treturn false",
            "\t\tend",
            "",
            "\t\tplayer:setStorageValue(params.storage, 1)",
            "\t\tif params.timer then",
            "\t\t\tplayer:setStorageValue(params.timer, os.time() + params.time * 3600) -- multiplicação por hora",
            "\t\tend",
            "\tend",
            "\treturn true",
            "end",
            ""
          ],
          "after": [
            "local executeReward = dofile(DATA_DIRECTORY .. \"/lib/core/world_quest_reward.lua\")"
          ]
        },
        {
          "startLine": 153,
          "before": [
            "\tlocal setting = ChestUnique[item.uid]",
            "\tif not setting then",
            "\t\treturn true",
            "\tend",
            "",
            "\tif setting.weight then",
            "\t\tlocal message = \"You have found a \" .. getItemName(setting.container) .. \".\"",
            "",
            "\t\tlocal backpack = player:getSlotItem(CONST_SLOT_BACKPACK)",
            "\t\tif not backpack or backpack:getEmptySlots(true) < 1 then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, message .. \" But you have no room to take it.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\t\tif (player:getFreeCapacity() / 100) < setting.weight then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, message .. \". Weighing \" .. setting.weight .. \" oz, it is too heavy for you to carry.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\tend",
            "",
            "\tif setting.useKV then",
            "\t\tif player:questKV(setting.questName):get(\"completed\") then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, \"The \" .. getItemName(setting.itemId) .. \" is empty.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\t\tif setting.timerStorage and player:questKV(setting.questName):get(\"timer\") and player:questKV(setting.questName):get(\"timer\") > os.time() then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, \"The \" .. getItemName(setting.itemId) .. \" is empty.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\telse",
            "\t\tif player:getStorageValue(setting.storage) >= 1 then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, \"The \" .. getItemName(setting.itemId) .. \" is empty.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\t\tif setting.timerStorage and player:getStorageValue(setting.timerStorage) > os.time() then",
            "\t\t\tplayer:sendTextMessage(MESSAGE_EVENT_ADVANCE, \"The \" .. getItemName(setting.itemId) .. \" is empty.\")",
            "\t\t\treturn true",
            "\t\tend",
            "\tend",
            "",
            "\tif setting.randomReward then",
            "\t\tlocal randomReward = math.random(#setting.randomReward)",
            "\t\tsetting.reward[1][1] = setting.randomReward[randomReward][1]",
            "\t\tsetting.reward[1][2] = setting.randomReward[randomReward][2]",
            "\tend",
            "",
            "\tlocal container = player:addItem(setting.container)",
            "\tfor i = 1, #setting.reward do",
            "\t\tlocal itemid = setting.reward[i][1]",
            "\t\tlocal count = setting.reward[i][2]",
            "\t\tlocal itemDescriptions = getItemDescriptions(itemid)",
            "\t\tlocal itemArticle = itemDescriptions.article",
            "\t\tlocal itemName = itemDescriptions.name",
            "\t\tlocal itemBagName = setting.container",
            "\t\tlocal itemBag = container",
            "",
            "\t\tif not setting.container then",
            "\t\t\tlocal addItemParams = {",
            "\t\t\t\tplayer = player,",
            "\t\t\t\titemid = itemid,",
            "\t\t\t\tcount = count,",
            "\t\t\t\tweight = getItemWeight(itemid) * count,",
            "\t\t\t\tstorage = setting.storage,",
            "\t\t\t\tkey = setting.isKey,",
            "\t\t\t\ttimer = setting.timerStorage,",
            "\t\t\t\ttime = setting.time,",
            "\t\t\t\tquestName = setting.questName,",
            "\t\t\t\tuseKV = setting.useKV,",
            "\t\t\t}",
            "",
            "\t\t\tif count > 1 and ItemType(itemid):isStackable() then",
            "\t\t\t\tif itemDescriptions.plural then",
            "\t\t\t\t\titemName = itemDescriptions.plural",
            "\t\t\t\tend",
            "\t\t\t\taddItemParams.message = \"You have found \" .. count .. \" \" .. itemName",
            "\t\t\telseif ItemType(itemid):getCharges() > 0 then",
            "\t\t\t\taddItemParams.message = \"You have found \" .. itemArticle .. \" \" .. itemName",
            "\t\t\t\tif not ItemType(itemid):isRune() then",
            "\t\t\t\t\taddItemParams.weight = getItemWeight(itemid)",
            "\t\t\t\tend",
            "\t\t\telse",
            "\t\t\t\taddItemParams.message = \"You have found \" .. itemArticle .. \" \" .. itemName",
            "\t\t\tend",
            "\t\t\tif not playerAddItem(addItemParams, item, i) then",
            "\t\t\t\treturn true",
            "\t\t\tend",
            "\t\tend",
            "",
            "\t\tif setting.container then",
            "\t\t\tlocal addContainerItemParams = {",
            "\t\t\t\tplayer = player,",
            "\t\t\t\titemid = itemid,",
            "\t\t\t\tcount = count,",
            "\t\t\t\tweight = setting.weight,",
            "\t\t\t\tstorage = setting.storage,",
            "\t\t\t\taction = setting.keyAction,",
            "\t\t\t\titemBagName = itemBagName,",
            "\t\t\t\tcontainerReward = itemBag,",
            "\t\t\t\tquestName = setting.questName,",
            "\t\t\t\tuseKV = setting.useKV,",
            "\t\t\t}",
            "",
            "\t\t\tif not playerAddContainerItem(addContainerItemParams, item, i) then",
            "\t\t\t\treturn true",
            "\t\t\tend",
            "\t\tend",
            "\tend",
            "",
            "\treturn true"
          ],
          "after": [
            "\tlocal setting = ChestUnique and ChestUnique[item.uid]",
            "\treturn executeReward(player, item, setting, AttributeTable[item.uid], achievementTable[item.uid])"
          ]
        }
      ]
    },
